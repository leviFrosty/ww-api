# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is used by wrangler for local development and is gitignored

# HERE API key from https://developer.here.com/
HERE_API_KEY=your_here_api_key_here

# Sentry DSN from https://sentry.io/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Apple Developer Team ID (10-character string) — used by the AASA endpoint
# for iOS universal links AND as the App Attest app-id prefix. Same value as
# APPLE_TEAM_ID in the witness-work Expo app config.
APPLE_TEAM_ID=YOUR_TEAM_ID_HERE

# --- Notes Import ---------------------------------------------------------

# OpenRouter API key. Requests are routed ZDR-only (zero data retention, no
# training) to the inference host. Create at https://openrouter.ai/keys and
# enable Zero Data Retention in https://openrouter.ai/settings/privacy.
OPENROUTER_API_KEY=your_openrouter_key_here

# RevenueCat REST v1 SECRET key (sk_...) for server-side Supporter checks.
# Project → API keys → Secret keys. NEVER ship this in the app.
REVENUECAT_API_KEY=sk_your_revenuecat_secret_here

# Local dev only: lets the iOS simulator (no Secure Enclave) skip App Attest by
# sending header `x-ww-dev-bypass: <this value>`. Leave UNSET in production.
NOTES_IMPORT_DEV_BYPASS_TOKEN=local-dev-bypass

# Dedicated local admin-reset token. Do not reuse the dev-bypass token.
ADMIN_API_TOKEN=generate_with_openssl_rand_base64_32

# Optional local fallbacks for the runtime `notes-import:limits` KV document.
# Allowances: -1 unlimited, 0 none, positive integer finite. Days may be fractional.
NOTES_IMPORT_FREE_CREDITS=5
NOTES_IMPORT_FREE_CREDITS_SUPPORTER=-1
NOTES_IMPORT_MAX_REFINEMENTS=5
NOTES_IMPORT_MAX_REFINEMENTS_SUPPORTER=-1
NOTES_IMPORT_WINDOW_DAYS=30

# Optional minimum app version for Notes Import (client-side gate; see AGENTS.md).
# NOTES_IMPORT_MIN_APP_VERSION=1.42.0

# --- Buddies relay ----------------------------------------------------------

# Kill-switch fallback when KV `buddies:enabled` is absent.
BUDDIES_ENABLED=true

# APNs token auth (.p8 key). Unset = pushes are skipped. APNs requires
# HTTP/2, so verify real pushes on the deployed dev worker.
# APNS_KEY_ID=ABCDE12345
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
